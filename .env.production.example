# Production environment template. Committed; never put a real value here.
#
# Both variables are NEXT_PUBLIC_, so `next build` inlines them into the client bundle: set them on
# your deploy platform as build arguments. `bun run build` checks them with --soft, because a build
# there gets them from the environment and no .env.production file exists. The env audit in
# /promote and /promote-deploy compares the live configuration with this file, so every key here is
# one production must carry.

NEXT_PUBLIC_API_URL=https://<api-host>
NEXT_PUBLIC_APP_URL=https://<app-host>
