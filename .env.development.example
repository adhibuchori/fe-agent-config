# Development environment template. Committed; never put a real value here.
#
# `bun run env:init` copies this file to .env.development (gitignored), and `bun dev` runs
# `scripts/next/env.ts check development`, which requires every key below that has a non-empty
# value. SSOT.md §6 says what each variable is for.

# The backend's base URL. The pull-request gate builds with this same value (quality-gate.yaml).
NEXT_PUBLIC_API_URL=http://localhost:4000

# This app's own public URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
