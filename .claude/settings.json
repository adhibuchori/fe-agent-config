{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(bun run:*)",
      "Bash(bun fl:*)",
      "Bash(bun check:*)",
      "Bash(bun test:*)",
      "Bash(bun generate:api:*)",
      "Read(**)",
      "Write(src/**)",
      "Write(.claude/session-logs/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push origin main:*)",
      "Write(.env*)",
      "Write(SSOT.md)",
      "Write(AGENTS.md)",
      "Write(PRODUCT.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/safety-check.sh" }]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/generated-guard.sh" }]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/token-guard.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/auto-lint.sh" },
          { "type": "command", "command": "bash .claude/hooks/auto-format.sh" },
          { "type": "command", "command": "bash .claude/hooks/run-tests.sh" },
          { "type": "command", "command": "bash .claude/hooks/i18n-sync-check.sh" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/notify.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/stop-check.sh" }]
      }
    ]
  }
}
